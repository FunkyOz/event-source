parameters:
    editorUrl: 'phpstorm://open?file=%%file%%&line=%%line%%'
    level: 9
    paths:
        - ./src
        - ./tests
        - ./examples
        - ./scripts
    excludePaths:
        # Uses response()->sse(), a Laravel macro that PHPStan can't see without the Larastan extension
        - ./examples/frameworks/laravel
